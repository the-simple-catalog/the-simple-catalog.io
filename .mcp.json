{
  "mcpServers": {
    "chrome-devtools-npx": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--chromeArg=--no-first-run",
        "--chromeArg=--no-default-browser-check",
        "--chromeArg=--disable-search-engine-choice-screen",
        "--no-usage-statistics",
        "--isolated"
      ],
      "env": {}
    }
  }
}
